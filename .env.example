# Template for .env — copy to .env and fill in real values. .env itself is gitignored.

# --- dr-cik (OpenDR/DRBench agents + evidence-recall judge) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Hugging Face (gated datasets/models, higher download rate limits) ---
HF_TOKEN=your_huggingface_token

# --- TimesX dataset_agent (google-research/TimesX/dataset_agent), if you run it ---
CUSTOMSEARCH_API_KEY=your_google_custom_search_api_key
CUSTOMSEARCH_CX_KEY=your_google_custom_search_engine_id

# --- Not currently used by any code here, kept for future agent/LLM work ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
